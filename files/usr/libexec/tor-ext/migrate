#!/bin/sh
# Migration of the previous manual tor setup to the managed one.
# The script is idempotent and is called from /etc/uci-defaults and from the
# package post-install hook.
. /usr/libexec/tor-ext/lib.sh

BACKUP_DIR=/root/tor-legacy-backup

log() {
	logger -t tor-ext "migrate: $*"
}

# 1) the control port and the privileges are required by the web interface
tor_ext_ensure_baseline

# 2) replace the old custom init script with the upstream procd one
if [ -f /etc/init.d/tor.apk-new ]; then
	mkdir -p "$BACKUP_DIR"
	[ -f /etc/init.d/tor ] && cp /etc/init.d/tor "$BACKUP_DIR/init.d-tor.legacy" 2>/dev/null
	mv /etc/init.d/tor.apk-new /etc/init.d/tor
	chmod 0755 /etc/init.d/tor
	log "installed the upstream procd init script for tor"
fi

# 3) the legacy firewall helper is not needed any more
if [ -f /etc/init.d/tor-firewall ]; then
	/etc/init.d/tor-firewall stop 2>/dev/null
	/etc/init.d/tor-firewall disable 2>/dev/null
	mkdir -p "$BACKUP_DIR"
	cp /etc/init.d/tor-firewall "$BACKUP_DIR/" 2>/dev/null
	rm -f /etc/init.d/tor-firewall
	log "removed the legacy tor-firewall service"
fi

# 4) import the client addresses of the previous setup
if [ -z "$(uci -q show tor_ext.proxy.client 2>/dev/null)" ]; then
	legacy_ips=""
	for f in /etc/init.d/tor /etc/init.d/tor-firewall /root/tor-legacy-backup/init.d-tor.legacy; do
		[ -r "$f" ] || continue
		ips=$(grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' "$f" 2>/dev/null | grep -vE '^(0|127|255)\.' | sort -u)
		for ip in $ips; do
			case "$ip" in
				192.168.*) legacy_ips="$legacy_ips $ip" ;;
			esac
		done
	done
	for ip in $legacy_ips; do
		uci -q get tor_ext.proxy.client | tr ' ' '\n' | grep -qx "$ip" || uci -q add_list tor_ext.proxy.client="$ip"
	done
	[ -n "$legacy_ips" ] && uci -q commit tor_ext && log "imported the client addresses:$legacy_ips"
fi

# 5) the watchdog cron entry
if ! grep -q 'tor-ext/watchdog' /etc/crontabs/root 2>/dev/null; then
	mkdir -p /etc/crontabs
	echo '*/5 * * * * /usr/libexec/tor-ext/watchdog >/dev/null 2>&1' >> /etc/crontabs/root
	/etc/init.d/cron reload 2>/dev/null
	log "installed the watchdog cron entry"
fi

# 6) the hourly split-lists refresh (periodic resolver/fetcher)
if ! grep -q 'tor-ext/lists due' /etc/crontabs/root 2>/dev/null; then
	mkdir -p /etc/crontabs
	echo '10 * * * * /usr/libexec/tor-ext/lists due >/dev/null 2>&1' >> /etc/crontabs/root
	/etc/init.d/cron reload 2>/dev/null
	log "installed the split lists cron entry"
fi

# 7) defaults for split tunneling (kept for existing configurations)
if [ -z "$(uci -q get tor_ext.split 2>/dev/null)" ]; then
	uci -q set tor_ext.split='split' || true
	uci -q set tor_ext.split.enabled='0'
	uci -q set tor_ext.split.mode='proxy'
	uci -q set tor_ext.split.scope='clients'
	uci -q set tor_ext.split.block_quic='1'
	uci -q set tor_ext.split.block_dot='1'
	uci -q set tor_ext.split.interval='6h'
	uci -q commit tor_ext
	log "added the split tunneling defaults"
fi

# 8) enable the service that applies the transparent proxying rules
/etc/init.d/tor-ext enable 2>/dev/null
/etc/init.d/tor enable 2>/dev/null

log "migration finished"
exit 0
