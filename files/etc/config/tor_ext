config proxy 'proxy'
	option enabled '0'
	option mode 'clients'
	option redirect_dns '1'
	option redirect_tcp '1'
	option killswitch '1'
	option block_ipv6 '1'
	option block_quic '1'
	option block_dot '1'
	option router_traffic '0'
	list client '192.168.1.107'

config watchdog 'watchdog'
	option enabled '1'
	option auto_restart '1'

config notify 'notify'
	option enabled '0'
	option telegram_token ''
	option telegram_chat ''
	option webhook ''

config backup 'backup'
	option keep '20'

config split 'split'
	option enabled '0'
	option mode 'proxy'
	option scope 'clients'
	option block_quic '1'
	option block_dot '1'
	option interval '6h'
	list lists 'youtube'
	list lists 'meta'
	list lists 'discord'
	list lists 'telegram'
